# Node modules
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
*.tsbuildinfo

# Editor folders and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.*
!.env.example

# Cypress
cypress/videos/
cypress/screenshots/

# Optional eslint cache
.eslintcache

# Nx (caso use monorepo Nx)
.nx/
.nx/cache/

# Others
.pnp/
.pnp.js

# VSCode settings (allow only recommended extensions)
!.vscode/extensions.json

# Mac system files
*.DS_Store

# Linux system files
*~

# Ignore lock files if you use only one package manager, otherwise keep the one you use
# package-lock.json
# yarn.lock

# Ignore test coverage
coverage/

# Ignore log files
*.log

# Ignore public/runtime-generated files
public/runtime/